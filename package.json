{
  "name": "js-lean",
  "version": "0.1.0",
  "description": "A CLI tool for validating and optimizing JavaScript package distribution archives.",
  "type": "module",
  "license": "MIT",
  "author": "Raphael Stolt <raphael.stolt@gmail.com>",
  "keywords": [
    "cli",
    "typescript",
    "npm",
    "package",
    "tarball",
    "publish",
    "lint",
    "optimize"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "js-lean": "dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
      "type": "git",
      "url": "https://github.com/lean-packages/js-lean.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:pkg": "tsx src/index.ts lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run lint:pkg && npm run test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
